# Multi-stage: build the React SPA, then serve it with nginx (which also proxies /api).
FROM node:20-alpine AS build
WORKDIR /app/frontend
ARG REACT_APP_BACKEND_URL
ENV REACT_APP_BACKEND_URL=$REACT_APP_BACKEND_URL CI=false DISABLE_ESLINT_PLUGIN=true
COPY frontend/package.json frontend/yarn.lock ./
RUN yarn install --frozen-lockfile
COPY frontend/ ./
RUN yarn build

FROM nginx:1.27-alpine
COPY deploy/self-host/nginx.docker.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/frontend/build /usr/share/nginx/html
EXPOSE 80
